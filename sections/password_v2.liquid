{% comment %}
  High-converting password page section.

  Features added on top of the base skeleton:
  1. Email capture (lead generation) via native Shopify customer/newsletter form
  2. Countdown timer to launch date
  3. Fully dynamic merchant-editable copy (eyebrow, heading, subheading, CTA texts)
  4. Working social links (facebook / instagram / twitter / tiktok / youtube)
  5. Progressive disclosure for the password field (details/summary, no JS needed)
     so the primary CTA for the ~95% of visitors without a password is "Notify me"

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign has_social = false
  if section.settings.social_facebook != blank or section.settings.social_instagram != blank or section.settings.social_twitter != blank or section.settings.social_tiktok != blank or section.settings.social_youtube != blank
    assign has_social = true
  endif
-%}

<div
  class="password-page"
  style="
    --password-bg-color: {{ section.settings.bg_color }};
    --password-overlay-color: {{ section.settings.overlay_color }};
    --password-overlay-opacity: {{ overlay_opacity }};
    --password-heading-color: {{ section.settings.heading_color }};
    --password-text-color: {{ section.settings.text_color }};
    --password-accent-color: {{ section.settings.accent_color }};
    --password-card-bg: {{ section.settings.card_bg }};
    --password-button-bg: {{ section.settings.button_bg }};
    --password-button-text: {{ section.settings.button_text }};
    --password-logo-width: {{ section.settings.logo_width }}px;
  "
>
  {%- if section.settings.bg_image != blank -%}
    <div class="password-page__bg">
      <img
        src="{{ section.settings.bg_image | image_url: width: 1920 }}"
        srcset="
          {{ section.settings.bg_image | image_url: width: 750 }} 750w,
          {{ section.settings.bg_image | image_url: width: 1280 }} 1280w,
          {{ section.settings.bg_image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
      >
      <div class="password-page__overlay"></div>
    </div>
  {%- endif -%}

  <div class="password-page__wrapper">
    <div class="password-page__card">

      {%- if section.settings.logo != blank -%}
        <div class="password-page__logo">
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_width }}"
            height="{{ section.settings.logo_width | times: section.settings.logo.aspect_ratio | default: section.settings.logo_width }}"
            loading="eager"
          >
        </div>
      {%- else -%}
        <p class="password-page__shop-name">{{ shop.name }}</p>
      {%- endif -%}

      {%- if section.settings.eyebrow_text != blank -%}
        <p class="password-page__eyebrow">{{ section.settings.eyebrow_text }}</p>
      {%- endif -%}

      <h1 class="password-page__title">{{ section.settings.heading }}</h1>

      <div class="password-page__message">
        {%- if section.settings.subheading != blank -%}
          {{ section.settings.subheading }}
        {%- elsif shop.password_message != blank -%}
          {{ shop.password_message }}
        {%- else -%}
          <p>We're putting the finishing touches on something special. Leave your email and we'll let you know the moment we open.</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_countdown and section.settings.countdown_date != blank -%}
        <div
          class="password-page__countdown"
          data-countdown
          data-countdown-date="{{ section.settings.countdown_date }}"
          data-countdown-end-text="{{ section.settings.countdown_end_text }}"
        >
          {%- if section.settings.countdown_heading != blank -%}
            <p class="password-page__countdown-label">{{ section.settings.countdown_heading }}</p>
          {%- endif -%}
          <div class="password-page__countdown-timer" data-countdown-timer>
            <div class="password-page__countdown-unit">
              <span class="password-page__countdown-number" data-countdown-days>00</span>
              <span class="password-page__countdown-caption">Days</span>
            </div>
            <div class="password-page__countdown-unit">
              <span class="password-page__countdown-number" data-countdown-hours>00</span>
              <span class="password-page__countdown-caption">Hrs</span>
            </div>
            <div class="password-page__countdown-unit">
              <span class="password-page__countdown-number" data-countdown-minutes>00</span>
              <span class="password-page__countdown-caption">Min</span>
            </div>
            <div class="password-page__countdown-unit">
              <span class="password-page__countdown-number" data-countdown-seconds>00</span>
              <span class="password-page__countdown-caption">Sec</span>
            </div>
          </div>
          <p class="password-page__countdown-ended" data-countdown-ended hidden></p>
        </div>
      {%- endif -%}

      {%- if section.settings.show_email_capture -%}
        <div class="password-page__notify">
          {%- if section.settings.email_capture_heading != blank -%}
            <p class="password-page__notify-heading">{{ section.settings.email_capture_heading }}</p>
          {%- endif -%}

          {%- form 'customer', class: 'password-page__notify-form' -%}
            <input type="hidden" name="contact[tags]" value="prospect, newsletter, password-page">
            <input type="hidden" name="contact[accepts_marketing]" value="true">

            {%- if form.posted_successfully? -%}
              <div class="password-page__notify-success" role="status">
                {{ section.settings.email_capture_success_text }}
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <div class="password-page__errors">
                  <p role="alert">{{ form.errors.messages['form'] | default: "Please enter a valid email address." }}</p>
                </div>
              {%- endif -%}
              <div class="password-page__notify-row">
                <label for="notify-email" class="visually-hidden">Email</label>
                <input
                  type="email"
                  id="notify-email"
                  name="contact[email]"
                  class="password-page__notify-input"
                  placeholder="{{ section.settings.email_capture_placeholder }}"
                  autocomplete="email"
                  required
                >
                <button type="submit" class="password-page__notify-submit">
                  {{ section.settings.email_capture_button_text }}
                </button>
              </div>
              <p class="password-page__notify-disclaimer">{{ section.settings.email_capture_disclaimer }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      <details class="password-page__password-toggle">
        <summary>{{ section.settings.password_toggle_text }}</summary>

        {%- form 'storefront_password', class: 'password-page__form' -%}
          {%- if form.errors -%}
            <div class="password-page__errors">
              {%- for field in form.errors -%}
                <p role="alert">{{ form.errors.messages[field] }}</p>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="password-page__field">
            <label for="password-input">
              {{ 'password.password' | t }}
            </label>

            <div class="password-page__input-wrap">
              <input
                type="password"
                name="password"
                id="password-input"
                class="password-page__input"
                autocomplete="current-password"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                required
              >
              <button
                type="button"
                class="password-page__toggle"
                aria-label="Show password"
                data-password-toggle
              >
                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                </svg>
                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden>
                  <path d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.24 4.24M9.9 5.1A11 11 0 0 1 12 5c7 0 11 7 11 7a13.2 13.2 0 0 1-3.1 3.9M6.6 6.6C3.9 8.3 1 12 1 12s4 7 11 7a10.6 10.6 0 0 0 3.4-.6" stroke="currentColor" stroke-width="1.5"/>
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" class="password-page__submit" data-password-submit>
            <span class="password-page__submit-text">{{ 'password.enter' | t }}</span>
            <svg class="password-page__spinner" viewBox="0 0 24 24" width="18" height="18" hidden>
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" fill="none" opacity="0.25"/>
              <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/>
            </svg>
          </button>
        {%- endform -%}
      </details>

      {%- if section.settings.show_admin_link -%}
        <a href="/admin" class="password-page__admin-link">
          {{ 'Are you the store owner? Log in here' }}
        </a>
      {%- endif -%}

      {%- if section.settings.show_social and has_social -%}
        <div class="password-page__social">
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.6C16.5 3.5 15.5 3.4 14.3 3.4c-2.5 0-4.2 1.5-4.2 4.3v2.2H7.3V13h2.8v8h3.4Z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_twitter != blank -%}
            <a href="{{ section.settings.social_twitter }}" aria-label="Twitter / X" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M18.2 3H21l-6.4 7.3L22 21h-6.1l-4.8-6.3L5.6 21H3l6.9-7.9L2.5 3h6.3l4.3 5.8L18.2 3Z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a href="{{ section.settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M16.6 3h-3.2v13.1a2.9 2.9 0 1 1-2.1-2.8V10a6 6 0 1 0 5.3 5.9V9.3a7.5 7.5 0 0 0 4.4 1.4V7.5a4.3 4.3 0 0 1-4.4-4.5Z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <a href="{{ section.settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M22 12s0-3.2-.4-4.7a2.8 2.8 0 0 0-2-2C17.9 5 12 5 12 5s-5.9 0-7.6.3a2.8 2.8 0 0 0-2 2C2 8.8 2 12 2 12s0 3.2.4 4.7a2.8 2.8 0 0 0 2 2C6.1 19 12 19 12 19s5.9 0 7.6-.3a2.8 2.8 0 0 0 2-2C22 15.2 22 12 22 12ZM10 15.3V8.7L15.8 12 10 15.3Z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .password-page {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--password-bg-color);
    padding: 24px;
    overflow-y: auto;
    font-family: inherit;
  }

  .password-page__bg {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  .password-page__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .password-page__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--password-overlay-color);
    opacity: var(--password-overlay-opacity);
  }

  .password-page__wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    justify-content: center;
    margin: auto;
  }

  .password-page__card {
    width: 100%;
    max-width: 440px;
    background: var(--password-card-bg);
    border-radius: 16px;
    padding: 40px 32px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
    text-align: center;
    animation: password-fade-in 0.5s ease both;
  }

  @keyframes password-fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .password-page__logo img {
    width: var(--password-logo-width);
    height: auto;
    margin: 0 auto 16px;
    display: block;
  }

  .password-page__shop-name {
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--password-text-color);
    margin: 0 0 16px;
    font-weight: 600;
  }

  .password-page__eyebrow {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--password-accent-color);
    font-weight: 700;
    margin: 0 0 10px;
  }

  .password-page__title {
    font-size: 26px;
    line-height: 1.3;
    margin: 0 0 12px;
    color: var(--password-heading-color);
  }

  .password-page__message {
    font-size: 15px;
    line-height: 1.6;
    color: var(--password-text-color);
    margin: 0 0 24px;
  }

  .password-page__message p {
    margin: 0;
  }

  /* Countdown */
  .password-page__countdown {
    margin-bottom: 26px;
  }

  .password-page__countdown-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--password-text-color);
    margin: 0 0 12px;
  }

  .password-page__countdown-timer {
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .password-page__countdown-unit {
    background: rgba(0, 0, 0, 0.04);
    border-radius: 10px;
    padding: 10px 6px;
    min-width: 56px;
  }

  .password-page__countdown-number {
    display: block;
    font-size: 20px;
    font-weight: 700;
    color: var(--password-heading-color);
    font-variant-numeric: tabular-nums;
  }

  .password-page__countdown-caption {
    display: block;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--password-text-color);
    margin-top: 2px;
  }

  .password-page__countdown-ended {
    font-size: 14px;
    font-weight: 600;
    color: var(--password-accent-color);
    margin: 0;
  }

  /* Email capture */
  .password-page__notify {
    background: rgba(0, 0, 0, 0.03);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 22px;
    text-align: left;
  }

  .password-page__notify-heading {
    font-size: 14px;
    font-weight: 700;
    color: var(--password-heading-color);
    margin: 0 0 12px;
    text-align: center;
  }

  .password-page__notify-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .password-page__notify-input {
    flex: 1 1 160px;
    box-sizing: border-box;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    font-size: 15px;
    outline: none;
  }

  .password-page__notify-input:focus {
    border-color: var(--password-accent-color);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
  }

  .password-page__notify-submit {
    flex: 0 0 auto;
    padding: 12px 20px;
    border-radius: 8px;
    border: none;
    background: var(--password-accent-color);
    color: var(--password-button-text);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .password-page__notify-submit:hover {
    opacity: 0.9;
  }

  .password-page__notify-disclaimer {
    font-size: 11px;
    color: var(--password-text-color);
    opacity: 0.7;
    margin: 8px 0 0;
    text-align: center;
  }

  .password-page__notify-success {
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--password-accent-color);
    padding: 6px 0;
  }

  /* Password (secondary, collapsed) */
  .password-page__password-toggle {
    margin-bottom: 6px;
    text-align: left;
  }

  .password-page__password-toggle summary {
    cursor: pointer;
    list-style: none;
    text-align: center;
    font-size: 13px;
    color: var(--password-text-color);
    text-decoration: underline;
    margin-bottom: 14px;
  }

  .password-page__password-toggle summary::-webkit-details-marker {
    display: none;
  }

  .password-page__errors {
    background: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.3);
    color: #b91c1c;
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 14px;
    font-size: 13px;
    text-align: left;
  }

  .password-page__errors p {
    margin: 0;
  }

  .password-page__field {
    text-align: left;
    margin-bottom: 16px;
  }

  .password-page__field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--password-heading-color);
  }

  .password-page__input-wrap {
    position: relative;
  }

  .password-page__input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 44px 12px 14px;
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    font-size: 15px;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .password-page__input:focus {
    border-color: var(--password-button-bg);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
  }

  .password-page__toggle {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 6px;
    cursor: pointer;
    color: #6b7280;
    display: flex;
  }

  .password-page__submit {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 16px;
    border-radius: 8px;
    border: none;
    background: var(--password-button-bg);
    color: var(--password-button-text);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s ease, transform 0.1s ease;
  }

  .password-page__submit:hover {
    opacity: 0.9;
  }

  .password-page__submit:active {
    transform: scale(0.98);
  }

  .password-page__spinner {
    animation: password-spin 0.8s linear infinite;
  }

  @keyframes password-spin {
    to { transform: rotate(360deg); }
  }

  .password-page__admin-link {
    display: inline-block;
    margin-top: 18px;
    font-size: 13px;
    color: var(--password-text-color);
    text-decoration: underline;
    opacity: 0.85;
  }

  .password-page__social {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 20px;
  }

  .password-page__social a {
    color: var(--password-text-color);
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }

  .password-page__social a:hover {
    opacity: 1;
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 480px) {
    .password-page__card {
      padding: 32px 22px;
    }

    .password-page__title {
      font-size: 21px;
    }

    .password-page__countdown-unit {
      min-width: 48px;
      padding: 8px 4px;
    }

    .password-page__notify-row {
      flex-direction: column;
    }

    .password-page__notify-submit {
      width: 100%;
    }
  }
{% endstyle %}

<script>
  (function () {
    // Password show/hide toggle
    var toggle = document.querySelector('[data-password-toggle]');
    var input = document.getElementById('password-input');

    if (toggle && input) {
      toggle.addEventListener('click', function () {
        var isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        toggle.querySelector('.icon-eye').hidden = isHidden;
        toggle.querySelector('.icon-eye-off').hidden = !isHidden;
        toggle.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
      });
    }

    // Submit loading state
    var passwordForm = document.querySelector('.password-page__form');
    var submitBtn = document.querySelector('[data-password-submit]');

    if (passwordForm && submitBtn) {
      passwordForm.addEventListener('submit', function () {
        submitBtn.disabled = true;
        submitBtn.querySelector('.password-page__submit-text').textContent = 'Checking...';
        submitBtn.querySelector('.password-page__spinner').hidden = false;
      });
    }

    // Countdown timer
    var countdownEl = document.querySelector('[data-countdown]');
    if (!countdownEl) return;

    var targetDate = new Date(countdownEl.getAttribute('data-countdown-date'));
    if (isNaN(targetDate.getTime())) return;

    var endText = countdownEl.getAttribute('data-countdown-end-text') || "We're live now! Refresh the page.";
    var timerEl = countdownEl.querySelector('[data-countdown-timer]');
    var endedEl = countdownEl.querySelector('[data-countdown-ended]');

    var daysEl = countdownEl.querySelector('[data-countdown-days]');
    var hoursEl = countdownEl.querySelector('[data-countdown-hours]');
    var minutesEl = countdownEl.querySelector('[data-countdown-minutes]');
    var secondsEl = countdownEl.querySelector('[data-countdown-seconds]');

    function pad(n) {
      return String(n).padStart(2, '0');
    }

    function tick() {
      var diff = targetDate.getTime() - Date.now();

      if (diff <= 0) {
        timerEl.hidden = true;
        endedEl.hidden = false;
        endedEl.textContent = endText;
        clearInterval(intervalId);
        return;
      }

      var days = Math.floor(diff / (1000 * 60 * 60 * 24));
      var hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      var minutes = Math.floor((diff / (1000 * 60)) % 60);
      var seconds = Math.floor((diff / 1000) % 60);

      daysEl.textContent = pad(days);
      hoursEl.textContent = pad(hours);
      minutesEl.textContent = pad(minutes);
      secondsEl.textContent = pad(seconds);
    }

    tick();
    var intervalId = setInterval(tick, 1000);
  })();
</script>

