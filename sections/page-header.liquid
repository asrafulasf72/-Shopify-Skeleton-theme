{% liquid
  assign padding_top = section.settings.padding_top | default: 0
  assign laptop_padding_top = padding_top | times: 80 | divided_by: 100
  assign tab_padding_top = laptop_padding_top | times: 80 | divided_by: 100
  assign mobile_padding_top = tab_padding_top | times: 50 | divided_by: 100

  assign padding_bottom = section.settings.padding_bottom | default: 0
  assign laptop_padding_bottom = padding_bottom | times: 80 | divided_by: 100
  assign tab_padding_bottom = laptop_padding_bottom | times: 80 | divided_by: 100
  assign mobile_padding_bottom = tab_padding_bottom | times: 50 | divided_by: 100

  assign margin_top = section.settings.margin_top | default: 0
  assign laptop_margin_top = margin_top | times: 80 | divided_by: 100
  assign tab_margin_top = laptop_margin_top | times: 80 | divided_by: 100
  assign mobile_margin_top = tab_margin_top | times: 50 | divided_by: 100

  assign margin_bottom = section.settings.margin_bottom | default: 0
  assign laptop_margin_bottom = margin_bottom | times: 80 | divided_by: 100
  assign tab_margin_bottom = laptop_margin_bottom | times: 80 | divided_by: 100
  assign mobile_margin_bottom = tab_margin_bottom | times: 50 | divided_by: 100

  assign divider_margin_top = section.settings.divider_margin_top | default: 0
  assign laptop_divider_margin_top = divider_margin_top | times: 80 | divided_by: 100
  assign tab_divider_margin_top = laptop_divider_margin_top | times: 80 | divided_by: 100
  assign mobile_divider_margin_top = tab_divider_margin_top | times: 50 | divided_by: 100

  assign divider_margin_bottom = section.settings.divider_margin_bottom | default: 0
  assign laptop_divider_margin_bottom = divider_margin_bottom | times: 80 | divided_by: 100
  assign tab_divider_margin_bottom = laptop_divider_margin_bottom | times: 80 | divided_by: 100
  assign mobile_divider_margin_bottom = tab_divider_margin_bottom | times: 50 | divided_by: 100
%}

{% stylesheet %}
  .nv-page-title__inner {
    display: flex;
    flex-direction: column;
    gap: var(--nv-pt-gap, 16px);
  }
{% endstylesheet %}

<div class="shopify-section-{{ section.id }} nv-page-title color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="nv-page-title__inner" style="--nv-pt-gap: {{ section.settings.gap }}px;">
      {% if section.settings.show_breadcrumb %}
        {% render 'breadcrumb' %}
      {% endif %}

      {% if section.settings.show_title %}
        {%- render 'page-title'
          , title: section.settings.heading
          , subtitle: section.settings.short_desc -%}
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_divider %}
    <div class="nv-header-divider"></div>
  {% endif %}
</div>

{% style %}
  .shopify-section-{{ section.id }} {
    padding-top: {{ mobile_padding_top }}px;
    padding-bottom: {{ mobile_padding_bottom }}px;
    margin-top: {{ mobile_margin_top }}px;
    margin-bottom: {{ mobile_margin_bottom }}px;
  }
  .shopify-section-{{ section.id }} .nv-header-divider {
    height: {{ section.settings.divider_height }}px;
    background-color: var(--nv-primary-border);
    border: 0;
    width: 100%;
    margin-top: {{ mobile_divider_margin_top }}px;
    margin-bottom: {{ mobile_divider_margin_bottom }}px;
  }

  @media (min-width: 768px) {
    .shopify-section-{{ section.id }} {
      padding-top: {{ tab_padding_top }}px;
      padding-bottom: {{ tab_padding_bottom }}px;
      margin-top: {{ tab_margin_top }}px;
      margin-bottom: {{ tab_margin_bottom }}px;
    }
    .shopify-section-{{ section.id }} .nv-header-divider {
      margin-top: {{ tab_divider_margin_top }}px;
      margin-bottom: {{ tab_divider_margin_bottom }}px;
    }
  }

  @media (min-width: 992px) {
    .shopify-section-{{ section.id }} {
      padding-top: {{ laptop_padding_top }}px;
      padding-bottom: {{ laptop_padding_bottom }}px;
      margin-top: {{ laptop_margin_top }}px;
      margin-bottom: {{ laptop_margin_bottom }}px;
    }
    .shopify-section-{{ section.id }} .nv-header-divider {
      margin-top: {{ laptop_divider_margin_top }}px;
      margin-bottom: {{ laptop_divider_margin_bottom }}px;
    }
  }

  @media (min-width: 1400px) {
    .shopify-section-{{ section.id }} {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
    }
    .shopify-section-{{ section.id }} .nv-header-divider {
      margin-top: {{ divider_margin_top }}px;
      margin-bottom: {{ divider_margin_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
  {
    "name": "t:sections.page_header.name",
    "tag": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "header",
        "content": "t:sections.page_header.headers.general"
      },
      {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.page_header.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
        "type": "range",
        "id": "padding_top",
        "label": "t:sections.page_header.settings.padding_top.label",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "t:sections.page_header.settings.padding_bottom.label",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "margin_top",
        "label": "t:sections.page_header.settings.margin_top.label",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "label": "t:sections.page_header.settings.margin_bottom.label",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "header",
        "content": "t:sections.page_header.headers.contents"
      },
      {
        "type": "range",
        "id": "gap",
        "label": "t:sections.page_header.settings.gap.label",
        "min": 0,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumb",
        "label": "t:sections.page_header.settings.show_breadcrumb.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_title",
        "label": "t:sections.page_header.settings.show_title.label",
        "default": true
      },
      {
        "type": "text",
        "id": "heading",
        "label": "t:sections.page_header.settings.heading.label",
        "visible_if": "{{section.settings.show_title}}"
      },
      {
        "type": "textarea",
        "id": "short_desc",
        "label": "t:sections.page_header.settings.short_desc.label",
        "visible_if": "{{section.settings.show_title}}"
      },   
      {
        "type": "checkbox",
        "id": "show_divider",
        "label": "t:sections.page_header.settings.show_divider.label",
        "default": true
      },
      {
        "type": "range",
        "id": "divider_height",
        "label": "t:sections.page_header.settings.divider_height.label",
        "min": 0,
        "max": 10,
        "step": 0.5,
        "unit": "px",
        "default": 0.5,
        "visible_if": "{{section.settings.show_divider}}"
      },
      {
        "type": "range",
        "id": "divider_margin_top",
        "label": "t:sections.page_header.settings.divider_margin_top.label",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 0,
        "visible_if": "{{section.settings.show_divider}}"
      },
      {
        "type": "range",
        "id": "divider_margin_bottom",
        "label": "t:sections.page_header.settings.divider_margin_bottom.label",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 0,
        "visible_if": "{{section.settings.show_divider}}"
      }
    ],
"presets": [
  {
    "name": "t:sections.page_header.presets.default.name",
    "settings": {
      "show_breadcrumb": true,
      "show_title": true,
      "heading": "Page title",
      "short_desc": "Add a short description to introduce this page.",
      "gap": 16,
      "show_divider": true,
      "divider_height": 0.5
    }
  }
]
  }
{% endschema %}
