{% comment %}
  High-converting password page section.

  Features:
  1. Email capture (lead generation) via native Shopify customer/newsletter form
  2. Countdown timer to launch date
  3. Fully dynamic merchant-editable copy (eyebrow, heading, subheading, CTA texts)
  4. Working social links (facebook / instagram / twitter / tiktok / youtube)
  5. Email capture and password field are mutually exclusive:
     - "Show email signup form" ON  -> only the email form shows, no password field
     - "Show email signup form" OFF -> the password field shows directly (no toggle)
     Store owners can always access /admin regardless of this setting.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign has_social = false
  if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_x_link != blank or settings.social_tiktok_link != blank or settings.social_youtube_link != blank
    assign has_social = true
  endif
-%}

{{ 'password-page.css' | asset_url | stylesheet_tag }}

<div
  class="password-page color-{{ section.settings.color_scheme }}"
  style="--password-overlay-opacity: {{ overlay_opacity }}; --password-logo-width: {{ section.settings.logo_width }}px;"
>
  {%- if section.settings.bg_image != blank -%}
    <div class="password-page__bg">
      <img
        src="{{ section.settings.bg_image | image_url: width: 1920 }}"
        srcset="
          {{ section.settings.bg_image | image_url: width: 750 }} 750w,
          {{ section.settings.bg_image | image_url: width: 1280 }} 1280w,
          {{ section.settings.bg_image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
      >
      <div class="password-page__overlay"></div>
    </div>
  {%- endif -%}

  <div class="password-page__wrapper">
    <div
      class="password-page__card"
     
      data-countdown-date="{{ section.settings.countdown_date }}"
      data-countdown-end-text="{{ section.settings.countdown_end_text | escape }}"
      x-init="{% if section.settings.show_countdown and section.settings.countdown_date != blank %}$store.password.initCountdown($el.dataset.countdownDate, $el.dataset.countdownEndText){% endif %}"
    >
      {%- if section.settings.logo != blank -%}
        <div class="password-page__logo">
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_width }}"
            height="{{ section.settings.logo_width | times: section.settings.logo.aspect_ratio | default: section.settings.logo_width }}"
            loading="eager"
          >
        </div>
      {%- else -%}
        <p class="password-page__shop-name">{{ shop.name }}</p>
      {%- endif -%}

      {%- if section.settings.eyebrow_text != blank -%}
        <p class="password-page__eyebrow">{{ section.settings.eyebrow_text }}</p>
      {%- endif -%}

      <h1 class="password-page__title">{{ section.settings.heading }}</h1>

      <div class="password-page__message">
        {%- if section.settings.subheading != blank -%}
          {{ section.settings.subheading }}
        {%- elsif shop.password_message != blank -%}
          {{ shop.password_message }}
        {%- else -%}
          <p>
            We're putting the finishing touches on something special. Leave your email and we'll let you know the moment
            we open.
          </p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_countdown and section.settings.countdown_date != blank -%}
        <div class="password-page__countdown">
          {%- if section.settings.countdown_heading != blank -%}
            <p class="password-page__countdown-label">{{ section.settings.countdown_heading }}</p>
          {%- endif -%}
          <div class="password-page__countdown-timer" x-show="$store.password.countdownEnded">
            <div class="password-page__countdown-unit">
              <span class="password-page__countdown-number" x-text="$store.password.days">00</span>
              <span class="password-page__countdown-caption">Days</span>
            </div>
            <div class="password-page__countdown-unit">
              <span class="password-page__countdown-number" x-text="$store.password.hours">00</span>
              <span class="password-page__countdown-caption">Hrs</span>
            </div>
            <div class="password-page__countdown-unit">
              <span class="password-page__countdown-number" x-text="$store.password.minutes">00</span>
              <span class="password-page__countdown-caption">Min</span>
            </div>
            <div class="password-page__countdown-unit">
              <span class="password-page__countdown-number" x-text="$store.password.seconds">00</span>
              <span class="password-page__countdown-caption">Sec</span>
            </div>
          </div>
          <p class="password-page__countdown-ended" x-show="$store.password.countdownEnded" x-text="$store.password.countdownEndText"></p>
        </div>
      {%- endif -%}

      {%- comment -%} Email signup form {%- endcomment -%}
     {%- comment -%} Email signup form {%- endcomment -%}
<div class="password-page__notify" x-show="$store.password.activeForm === 'email'">
  {%- form 'customer', class: 'password-page__notify-form' -%}
    <input type="hidden" name="contact[tags]" value="prospect, newsletter, password-page">
    <input type="hidden" name="contact[accepts_marketing]" value="true">

    {%- if form.posted_successfully? -%}
      <div class="password-page__notify-success" role="status">
        {{ section.settings.email_capture_success_text }}
      </div>
    {%- else -%}
      {%- if form.errors -%}
        <div class="password-page__errors">
          <p role="alert">{{ form.errors.messages.form | default: 'Please enter a valid email address.' }}</p>
        </div>
      {%- endif -%}

      <div class="password-page__field">
        <label for="notify-email">
          {{ section.settings.email_capture_heading | default: 'Email' }}
        </label>
        <input
          type="email"
          id="notify-email"
          name="contact[email]"
          class="password-page__input"
          placeholder="{{ section.settings.email_capture_placeholder }}"
          autocomplete="email"
          required
        >
      </div>

      <button type="submit" class="password-page__submit">
        {{ section.settings.email_capture_button_text }}
      </button>

      <p class="password-page__notify-disclaimer">{{ section.settings.email_capture_disclaimer }}</p>
    {%- endif -%}
  {%- endform -%}
</div>

      {%- comment -%} Password form {%- endcomment -%}
      <div class="password-page__password-direct" x-show="$store.password.activeForm === 'password'">
        {%- form 'storefront_password', class: 'password-page__form' -%}
          {%- if form.errors -%}
            <div class="password-page__errors">
              {%- for field in form.errors -%}
                <p role="alert">{{ form.errors.messages[field] }}</p>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="password-page__field">
            <label for="password-input">
              {{ 'password.password' | t }}
            </label>

            <div class="password-page__input-wrap">
              <input
                :type="$store.password.showPassword ? 'text' : 'password'"
                name="password"
                id="password-input"
                class="password-page__input"
                autocomplete="current-password"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                required
              >
              <button
                type="button"
                class="password-page__toggle"
                :aria-label="$store.password.showPassword ? 'Hide password' : 'Show password'"
                @click="$store.password.togglePasswordVisibility()"
              >
                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" aria-hidden="true" x-show="!$store.password.showPassword">
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                </svg>
                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" aria-hidden="true" x-show="$store.password.showPassword">
                  <path d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.24 4.24M9.9 5.1A11 11 0 0 1 12 5c7 0 11 7 11 7a13.2 13.2 0 0 1-3.1 3.9M6.6 6.6C3.9 8.3 1 12 1 12s4 7 11 7a10.6 10.6 0 0 0 3.4-.6" stroke="currentColor" stroke-width="1.5"/>
                </svg>
              </button>
            </div>
          </div>

          <button
            type="submit"
            class="password-page__submit"
            :disabled="$store.password.isSubmitting"
            @click="$store.password.handlePasswordSubmit()"
          >
            <span class="password-page__submit-text" x-show="!$store.password.isSubmitting">Enter</span>
            <span class="password-page__submit-text" x-show="$store.password.isSubmitting">Checking...</span>
          </button>
        {%- endform -%}
      </div>

      {%- comment -%} Toggle row {%- endcomment -%}
      <div class="password-page__form-toggle">
        <button
          type="button"
          class="password-page__form-toggle-link"
          x-show="$store.password.activeForm === 'email'"
          @click="$store.password.setActiveForm('password')"
        >
          Login with password
        </button>
        <button
          type="button"
          class="password-page__form-toggle-link"
          x-show="$store.password.activeForm === 'password'"
          @click="$store.password.setActiveForm('email')"
        >
          Subscribe
        </button>
      </div>

      {%- if section.settings.show_admin_link -%}
        <a href="/admin" class="password-page__admin-link">
          {{ 'Are you the store owner? Log in here' }}
        </a>
      {%- endif -%}

      {%- if section.settings.show_social and has_social -%}
        <div class="password-page__social">
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" aria-label="Facebook" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.6C16.5 3.5 15.5 3.4 14.3 3.4c-2.5 0-4.2 1.5-4.2 4.3v2.2H7.3V13h2.8v8h3.4Z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if settings.social_x_link != blank -%}
            <a href="{{ settings.social_x_link }}" aria-label="Twitter / X" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M18.2 3H21l-6.4 7.3L22 21h-6.1l-4.8-6.3L5.6 21H3l6.9-7.9L2.5 3h6.3l4.3 5.8L18.2 3Z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M16.6 3h-3.2v13.1a2.9 2.9 0 1 1-2.1-2.8V10a6 6 0 1 0 5.3 5.9V9.3a7.5 7.5 0 0 0 4.4 1.4V7.5a4.3 4.3 0 0 1-4.4-4.5Z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" aria-label="YouTube" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M22 12s0-3.2-.4-4.7a2.8 2.8 0 0 0-2-2C17.9 5 12 5 12 5s-5.9 0-7.6.3a2.8 2.8 0 0 0-2 2C2 8.8 2 12 2 12s0 3.2.4 4.7a2.8 2.8 0 0 0 2 2C6.1 19 12 19 12 19s5.9 0 7.6-.3a2.8 2.8 0 0 0 2-2C22 15.2 22 12 22 12ZM10 15.3V8.7L15.8 12 10 15.3Z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "COMING SOON",
      "info": "Small label shown above the heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're launching something special"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Leave your email and we'll let you know the moment we open our doors.</p>",
      "info": "Leave blank to use the store's default password page message instead."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (on background image)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "header",
      "content": "Countdown timer"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown timer",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_heading",
      "label": "Countdown label",
      "default": "Launching in"
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Launch date & time",
      "info": "Format: YYYY-MM-DDTHH:MM, e.g. 2026-12-25T00:00 (uses your store's local time zone).",
      "placeholder": "2026-12-25T00:00"
    },
    {
      "type": "text",
      "id": "countdown_end_text",
      "label": "Message shown after countdown ends",
      "default": "We're live now! Refresh the page."
    },

    {
      "type": "text",
      "id": "email_capture_heading",
      "label": "Form heading",
      "default": "Get notified when we launch"
    },
    {
      "type": "text",
      "id": "email_capture_placeholder",
      "label": "Email input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "email_capture_button_text",
      "label": "Button text",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "email_capture_success_text",
      "label": "Success message",
      "default": "Thanks! We'll email you as soon as we launch."
    },
    {
      "type": "text",
      "id": "email_capture_disclaimer",
      "label": "Disclaimer text",
      "default": "No spam. We'll only email you about our launch."
    },
    {
      "type": "header",
      "content": "Store owner link"
    },
    {
      "type": "checkbox",
      "id": "show_admin_link",
      "label": "Show \"store owner? log in\" link",
      "default": true
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true,
      "info": "Uses the social links configured under Theme settings → Social media."
    }
  ]
}
{% endschema %}
